{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for MinistryStage",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "shell:allow-execute",
    "shell:allow-spawn",
    "shell:allow-open",
    "dialog:default",
    "core:window:default",
    "core:window:allow-create",
    "core:webview:allow-create-webview-window"
  ]
}
